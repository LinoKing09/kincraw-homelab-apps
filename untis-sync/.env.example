# ---- WebUntis (aus der Login-Adresse ablesen) ----
# https://nessa.webuntis.com/WebUntis/?school=gym-beispiel
UNTIS_SERVER=nessa.webuntis.com
UNTIS_SCHOOL=gym-beispiel
UNTIS_USER=vorname.nachname
UNTIS_PASSWORD=geheim

# ---- Google Kalender ----
# primary = Hauptkalender. Das Label muss auf genau diesem Kalender existieren.
GCAL_CALENDAR_ID=primary
GCAL_LABEL_NAME=Schule
# Erinnerung vor jeder Stunde in Minuten (leer = keine)
REMINDER_MINUTES=
# 1 = "Mathematik", 0 = "M"
USE_LONG_SUBJECT_NAMES=1

# ---- Sync ----
SYNC_INTERVAL_MINUTES=120
SYNC_WEEKS_AHEAD=4
# mark = Entfall bleibt als "ENTFALL – ..." (als frei markiert), delete = Termin entfernen
CANCELLED_MODE=mark
# Doppelstunden zu einem Termin zusammenfassen
MERGE_DOUBLE_LESSONS=1
MERGE_GAP_MINUTES=5
