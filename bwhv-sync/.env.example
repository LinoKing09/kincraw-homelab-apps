# Einstellungen für BWHV FWL Sync
#
# Auf docker1 liegt diese Datei als /opt/stack/bwhv-sync/.env
# (compose.yaml liest sie per env_file ein). Übernehmen mit:
#   cd /opt/stack && docker compose up -d bwhv-sync
# Fehlt die Datei, startet die App mit Standardwerten – ohne Passwort.
#
# Format: NAME=wert – ohne Leerzeichen um das "=". Zeilen mit # sind Kommentare.
# Enthält ein Wert ein "$", den Wert in einfache Anführungszeichen setzen:
#   BWHV_PASSWORD='ab$cd'
#
# Die .env-Datei enthält das Passwort und gehört NICHT ins Git-Repository
# (steht in .gitignore).

# --- Zugang -----------------------------------------------------------------

# Passwort für die Oberfläche. Leer = ohne Anmeldung (nur im Heimnetz vertretbar!)
BWHV_PASSWORD=bitte-aendern

# Wie viele Tage ein Gerät angemeldet bleibt
BWHV_LOGIN_DAYS=90

# --- Kalender ---------------------------------------------------------------

# Name des Google-Kalenders (wird angelegt, falls er fehlt)
BWHV_CALENDAR_NAME=BWHV Schiri FWL

# Name des Kalender-Labels für den Termin "FWL - aktuellster Punkt"
BWHV_MARKER_LABEL=FWL fertig

# Zeitzone für alle Termine
BWHV_TIMEZONE=Europe/Berlin

# --- Oberfläche -------------------------------------------------------------

# Link "Phoenix2 öffnen" im Import-Bereich. Leer lassen (BWHV_PORTAL_URL=) blendet ihn aus.
BWHV_PORTAL_URL=https://bwhv.it4sport.de/auth/login

# --- Erinnerung (Gotify) ----------------------------------------------------
# Gotify selbst wird in der Oberfläche eingerichtet (Karte "Erinnerung").
# Optional: Adresse der App – Antippen der Gotify-Nachricht öffnet sie dann.
BWHV_APP_URL=
